const SEC_PER_Q=1.6*60,PLUS=1.5,MINUS=0.4,MIXED_COUNT=30,L='ABCDE';
const fmt=s=>String(Math.floor(s/60)).padStart(2,'0')+':'+String(Math.floor(s%60)).padStart(2,'0');
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const esc=s=>s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));

class Question{
  constructor(raw,slot){this.id=raw.n;this.text=raw.q;this.img=raw.i;
    const rest=shuffle(raw.o.slice(1));rest.splice(slot,0,raw.o[0]);
    this.options=rest;this.correct=slot;this.chosen=null}
  get status(){return this.chosen===null?'u':this.chosen===this.correct?'c':'w'}
}
class Timer{
  constructor(sec,onTick,onEnd){this.left=sec;this.onTick=onTick;this.onEnd=onEnd}
  start(){this.h=setInterval(()=>{this.left--;this.onTick(this.left);if(this.left<=0){this.stop();this.onEnd()}},1000)}
  stop(){clearInterval(this.h)}
}
class Quiz{
  constructor(title,raws){
    const slots=shuffle(raws.map((_,i)=>i%5));          // balanced A–E positions
    this.title=title;this.questions=raws.map((r,i)=>new Question(r,slots[i]));
    this.index=0;this.total=Math.round(raws.length*SEC_PER_Q);this.used=0;this.done=false}
  get current(){return this.questions[this.index]}
  go(i){if(i>=0&&i<this.questions.length)this.index=i}
  choose(k){this.current.chosen=k}
  count(s){return this.questions.filter(q=>q.status===s).length}
  get score(){return +(this.count('c')*PLUS-this.count('w')*MINUS).toFixed(2)}
  get max(){return this.questions.length*PLUS}
}
class App{
  constructor(root){this.root=root;this.home()}
  shell(inner,right=''){this.root.innerHTML=`<div class="bar"><div class="brand" id="brand">Chemistry Practice</div><div class="sp"></div>${right}</div>${inner}`;
    document.getElementById('brand').onclick=()=>this.leave()}
  leave(){if(this.quiz&&!this.quiz.done&&!confirm('Leave this quiz? Your progress will be lost.'))return;this.stop();this.home()}
  stop(){if(this.timer)this.timer.stop();this.quiz=null;this.timer=null;document.onkeydown=null}
  home(){
    const cnt=t=>DATA.filter(q=>q.t===t).length;
    const card=(id,name,n,wide)=>`<button class="card${wide?' wide':''}" data-t="${id}"><h3>${name}</h3><p>${n} questions · ${Math.round(n*1.6*10)/10} min</p><span class="go">→</span></button>`;
    this.shell(`<div class="wrap"><h1>Chemistry practice</h1><p class="lead">Second Session 2027 · ${DATA.length.toLocaleString()} questions sorted into ${TOPICS.length} topics.</p></div>
    <div class="wrap"><h2>Choose a topic</h2><div class="grid">
    ${card('all','All topics (mixed)',MIXED_COUNT,true)}
    ${TOPICS.map((n,i)=>card(i+1,`${i+1}. ${n}`,cnt(i+1))).join('')}</div></div>
    <div class="note"><div class="wrap"><b>Marking:</b> +1.5 for a correct answer, −0.4 for a wrong answer, 0 if left blank. Time allowed: 1.6 minutes per question. Answer order is shuffled every time a quiz starts.</div></div>`);
    this.root.querySelectorAll('.card').forEach(b=>b.onclick=()=>this.start(b.dataset.t));
  }
  start(t){this.quizTopic=t;
    let raws,title;
    if(t==='all'){raws=shuffle(DATA).slice(0,MIXED_COUNT);title='All topics (mixed)'}
    else{raws=DATA.filter(q=>q.t==+t);title=`${t}. ${TOPICS[t-1]}`}
    this.quiz=new Quiz(title,raws);
    this.timer=new Timer(this.quiz.total,s=>this.tick(s),()=>this.finish(true));
    this.timer.start();this.quizView();
    document.onkeydown=e=>{if(e.key==='ArrowRight')this.step(1);if(e.key==='ArrowLeft')this.step(-1)};
  }
  tick(s){const el=document.getElementById('timer');this.quiz.used=this.quiz.total-s;if(el){el.textContent=fmt(s);el.classList.toggle('low',s<60)}}
  step(d){this.quiz.go(this.quiz.index+d);this.quizView()}
  quizView(){
    const z=this.quiz,q=z.current,n=z.questions.length;
    this.shell(`<div class="wrap"><div class="quiz"><div>
      <div class="qcard"><div class="qno">Question ${z.index+1} of ${n}</div>
      <p class="stem">${esc(q.text)}</p>${q.img!==undefined?`<img class="qimg" src="${IMGS[q.img]}" alt="Periodic table diagram">`:''}
      ${q.options.map((o,k)=>`<button class="opt${q.chosen===k?' sel':''}" data-k="${k}"><span class="l">${L[k]}</span><span>${esc(o)}</span></button>`).join('')}
      <div class="nav"><button class="btn line" id="prev" ${z.index?'':'disabled'}>← Previous</button><span class="sp"></span>
      <button class="btn" id="next" ${z.index<n-1?'':'disabled'}>Next →</button></div></div></div>
      <aside class="side"><h4>${esc(z.title)}</h4><small>${z.count('u')} of ${n} unanswered</small>
      <div class="pal">${z.questions.map((x,i)=>`<button data-i="${i}" class="${x.chosen!==null?'ans':''}${i===z.index?' cur':''}">${i+1}</button>`).join('')}</div>
      <div class="legend"><span><i class="a"></i>Answered</span><span><i></i>Unanswered</span></div>
      <button class="btn red" id="fin" style="width:100%">Finish quiz</button></aside></div></div>`,
      `<span class="meta">${esc(z.title)}</span><div class="timer${this.timer.left<60?' low':''}" id="timer">${fmt(this.timer.left)}</div>`);
    const r=this.root;
    r.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{z.choose(+b.dataset.k);this.quizView()});
    r.querySelectorAll('.pal button').forEach(b=>b.onclick=()=>{z.go(+b.dataset.i);this.quizView()});
    r.querySelector('#prev').onclick=()=>this.step(-1);r.querySelector('#next').onclick=()=>this.step(1);
    r.querySelector('#fin').onclick=()=>this.finish(false);
    const pal=r.querySelector('.pal'),cur=pal.querySelector('.cur');if(cur)pal.scrollTop=Math.max(0,cur.offsetTop-pal.offsetTop-80);
  }
  finish(auto){
    const z=this.quiz,u=z.count('u');
    if(!auto&&!confirm(u?`${u} question${u>1?'s are':' is'} still unanswered. Finish the quiz?`:'Finish the quiz?'))return;
    this.timer.stop();z.done=true;z.used=z.total-this.timer.left;document.onkeydown=null;this.result(auto)
  }
  review(i){
    const q=this.quiz.questions[i],st={c:['Correct','+1.5'],w:['Wrong','−0.4'],u:['Not answered','0']}[q.status];
    const m=document.createElement('div');m.className='mask';
    m.innerHTML=`<div class="dlg"><div class="top"><div class="qno">Question ${i+1} · ${st[0]} (${st[1]})</div><button class="x" aria-label="Close">×</button></div>
      ${q.c?'':`<p class="stem">${esc(q.text)}</p>`}${q.img!==undefined?`<img class="qimg" src="${IMGS[q.img]}" alt="Question figure">`:''}
      ${q.options.map((o,k)=>{const r=k===q.correct,w=k===q.chosen&&!r;return `<div class="opt${r?' right':w?' wrong':''}"><span class="l">${L[k]}</span><span>${esc(o)}</span>${r?'<b class="tag">Correct answer</b>':w?'<b class="tag">Your answer</b>':k===q.chosen?'':''}</div>`}).join('')}</div>`;
    const close=()=>{m.remove();document.removeEventListener('keydown',esc_)};
    const esc_=e=>{if(e.key==='Escape')close()};
    m.onclick=e=>{if(e.target===m||e.target.classList.contains('x'))close()};
    document.addEventListener('keydown',esc_);document.body.appendChild(m);
  }
  result(auto){
    const z=this.quiz,lab={c:'Correct',w:'Wrong',u:'Blank'},pt={c:'+1.5',w:'−0.4',u:'0'};
    this.shell(`<div class="wrap"><div class="res"><div class="qno">${esc(z.title)}${auto?' · time expired':''}</div>
      <div class="score">${z.score.toFixed(2)}</div><div class="lead" style="margin:6px auto 0">out of ${z.max.toFixed(1)}</div></div>
      <div class="stats"><div class="stat"><b>${z.count('c')}</b><span>Correct (+1.5)</span></div><div class="stat"><b>${z.count('w')}</b><span>Wrong (−0.4)</span></div>
      <div class="stat"><b>${z.count('u')}</b><span>Blank (0)</span></div><div class="stat"><b>${fmt(z.used)}</b><span>of ${fmt(z.total)} used</span></div></div>
      <h2 style="margin-top:28px">Question status</h2>
      <div class="st">${z.questions.map((q,i)=>`<button class="${q.status}" data-i="${i}">Q${i+1}<small>${lab[q.status]} · ${pt[q.status]}</small></button>`).join('')}</div>
      <div class="nav" style="margin-bottom:64px"><button class="btn red" id="again">Retake this quiz</button><button class="btn line" id="back">Back to topics</button></div></div>`);
    this.root.querySelector('#back').onclick=()=>{this.stop();this.home()};
    this.root.querySelector('#again').onclick=()=>{const t=this.quizTopic;this.stop();this.start(t)};
    this.root.querySelectorAll('.st button').forEach(b=>b.onclick=()=>this.review(+b.dataset.i));
    window.scrollTo(0,0);
  }
}
new App(document.getElementById('app'));
</script></body></html>

